# Required: your own password for the admin user (at least 12 characters).
GUARD_ADMIN_PASSWORD=

# Initial RTSP source; subsequent changes are saved in the admin interface.
CAMERA_RTSP_URL=rtsp://95.163.220.75:8554/mystream
# SSH board address is independent of the RTSP relay.
CAMERA_SSH_HOST=192.168.1.199

# Defaults to access from this computer only.
# For LAN access set DOZOR_BIND_ADDRESS=0.0.0.0 and GO2RTC_HOST to the host's LAN IP.
DOZOR_BIND_ADDRESS=127.0.0.1
GO2RTC_HOST=127.0.0.1

# Optional: at least 24 characters; leave empty while no detector agent is used.
GUARD_AGENT_TOKEN=
